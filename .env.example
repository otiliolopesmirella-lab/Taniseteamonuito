GEMINI_API_KEY=
FIREBASE_API_KEY=
DISABLE_HMR=false

# ==============================================================================
# Firebase de Producao (KingHost)
# Crie um arquivo .env.production com os dados do SEU projeto Firebase de producao
# antes de rodar "npm run build" para subir na KingHost.
# Quando vazio (aqui no ambiente de testes), o jogo usa firebase-applet-config.json.
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: deixe (default) para o banco Firestore padrao do seu projeto Firebase
VITE_FIREBASE_DATABASE_ID=(default)
